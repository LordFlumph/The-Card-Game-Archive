  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b><size=+10>Tips and Strategies</size></b>

    <b>\u2022 1. Use Your
    Empty Columns Well:</b> An empty column is your most valuable asset in Spider.
    Use empty space to temporarily store cards while you reorganise columns.

    <b>\u2022
    2. Only Deal When You Have To:</b> Dealing is useful as it gives you 10 more
    cards to play with, but it also buries your existing cards. Prioritise other
    moves before you deal.

    <b>\u2022 3. Uncover Hidden Cards:</b> Dealing is
    useful as it gives you 10 more cards to play with, but it also buries your existing
    cards. Prioritise other moves before you deal.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7953b3aff3010de47827554b597de01f, type: 2}
