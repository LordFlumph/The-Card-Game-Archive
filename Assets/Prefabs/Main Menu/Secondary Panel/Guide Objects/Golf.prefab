  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><size=+10>Objective</size></b>\nThe objective of Golf is to clear all
    cards from the Tableau onto the Foundation pile by building a sequence of cards
    that are one rank higher or one rank lower than the current top card of the Foundation.
    \n\n<b><size=+10>Layout</size></b>\n<b>\\u2022 Tableau:</b> The main playing
    area, consisting of 35 cards dealt face-up into 7 columns. Only the bottom card
    of each column is available for play.\n<b>\\u2022 Stock:</b> The face-down pile
    containing the remaining 17 cards, used to deal a new card onto the Foundation
    when no moves remain.\n<b>\\u2022 Foundation:</b> The pile where cards cleared
    from the Tableau are built in sequence."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7953b3aff3010de47827554b597de01f, type: 2}
