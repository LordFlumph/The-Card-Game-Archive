  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><size=+10>Objective</size></b>\nThe objective of Klondike is to move
    all 52 cards into 4 same-suit stacks in ascending order, from Ace up to King.
    \n\n<b><size=+10>Layout</size></b>\n<b>\\u2022 Tableau:</b> The main playing
    area, consisting of 7 columns initially containing 28 cards, with the bottom
    card of each column face up.\n<b>\\u2022 Stock:</b> The face-down pile containing
    the remaining cards.\n<b>\\u2022 Waste:</b> The face-up pile where cards drawn
    from the stock are stored until used.\n<b>\\u2022 Foundation:</b> The area where
    the final card stacks are built."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7953b3aff3010de47827554b597de01f, type: 2}
  m_sharedMaterial: {fileID: -6622473957194473056, guid: 7953b3aff3010de47827554b597de01f, type: 2}
