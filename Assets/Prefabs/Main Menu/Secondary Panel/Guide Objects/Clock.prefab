      m_Calls: []
  m_text: '<b><size=+10>How To Win</size></b>

    You win the game if all 52 cards
    are sorted into their matching piles. However, if the fourth King is drawn before
    all other cards are revealed, the game ends immediately in a loss.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7953b3aff3010de47827554b597de01f, type: 2}
