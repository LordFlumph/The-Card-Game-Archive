      m_Calls: []
  m_text: "<b><size=+10>Objective</size></b>\nThe objective of Clock is to sort all
    cards into same-rank piles, with the final card being the fourth King. \n\n<b><size=+10>Layout</size></b>\n12
    piles are arranged in a circle around a 13th pile. Each pile corresponds to a
    card Rank and contains 4 face-down cards."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7953b3aff3010de47827554b597de01f, type: 2}
  m_sharedMaterial: {fileID: -6622473957194473056, guid: 7953b3aff3010de47827554b597de01f, type: 2}
