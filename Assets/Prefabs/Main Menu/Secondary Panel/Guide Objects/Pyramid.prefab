  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b><size=+10>Card Values</size></b>

    \u2022 Ace = 1

    \u2022 Numeric
    cards are worth their face value

    \u2022 Jack = 11, Queen = 12, King = 13


    <b><size=+10>How
    To Play</size></b>

    Select any two exposed, unobstructed cards whose values
    add up to 13 to remove them from the game. Since Kings are worth 13 on their
    own, tapping an exposed King immediately removes it from the board.


    You
    can pair two uncovered cards from within the Pyramid, or pair an exposed Pyramid
    card with the top Waste card. When you run out of moves, tap the Stock to draw
    a new card.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7953b3aff3010de47827554b597de01f, type: 2}
