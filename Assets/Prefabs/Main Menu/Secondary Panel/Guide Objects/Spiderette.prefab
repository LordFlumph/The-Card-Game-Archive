  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b><size=+10>Tips and Strategies</size></b>

    <b>\u2022 Use Your Empty
    Columns Well:</b> An empty column is your most valuable asset in Spiderette.
    Use empty space to temporarily store cards while you reorganise columns.

    <b>\u2022
    Only Deal When You Have To:</b> Dealing is useful as it gives you 10 more cards
    to play with, but it also buries your existing cards. Prioritise other moves
    before you deal.

    <b>\u2022 Uncover Hidden Cards:</b> The quicker that you
    can reveal all the face-down cards, the easier it will be to plan ahead. It will
    also bring you closer to having an empty column.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7953b3aff3010de47827554b597de01f, type: 2}
  m_sharedMaterial: {fileID: -6622473957194473056, guid: 7953b3aff3010de47827554b597de01f, type: 2}
